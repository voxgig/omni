          { "id": "fib/matchinfo#partial", "doc": true, "in": 6, "match": { "out": { "val": 8 } } },
          { "in": 6, "match": { "out": { "val": 8, "even": true } } },
          { "in": 6, "match": { "out": { "label": "/^fib\\(6\\)=8$/" } } },
          { "in": 6, "match": { "out": { "label": "fib(6)" } } },
          { "in": 6, "match": { "out": { "label": "__EXISTS__" } } },
          { "in": 6, "match": { "out": { "nosuchkey": "__UNDEF__" } } },
          { "in": 0, "match": { "out": { "prev": "__NULL__" } } },
          { "in": 9, "match": { "in": 9, "out": { "n": 9, "val": 34, "even": true } } }
        ]
      },

      "client": {
        "set": [
          { "id": "fib/client#default", "doc": true, "in": 5, "out": 5 },
          { "client": "plain", "in": 5, "out": 5 },
          { "client": "shift", "in": 5, "out": 13 },
          { "client": "shift", "in": 0, "out": 1 },
