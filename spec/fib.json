          { "in": -5, "err": "NEGATIVE" },
          { "in": -2, "err": "fib: negative index: -2" },
          { "in": -3, "err": "/negative index: -3$/" },
          { "in": 2.5, "err": "non-integer" },
          { "in": "x", "err": "not a number" },
          { "in": true, "err": "not a number" },
          { "in": [1], "err": "not a number" },
          { "in": { "n": 1 }, "err": "not a number" },
          { "in": -1, "err": true, "match": { "err": { "message": "negative index" } } },
          { "in": "zz", "err": true, "match": { "in": "zz", "err": { "message": "/not a number/" } } }
        ]
      },

      "match": {
        "set": [
          { "id": "fib/match#out", "doc": true, "in": 10, "match": { "out": 55 } },
          { "in": 7, "out": 13, "match": { "out": 13 } },
          { "in": 12, "match": { "in": 12, "out": 144 } }
